    "express": "^5.2.1",
    "viem": "^2.55.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
