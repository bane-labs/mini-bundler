# =============================================
# Mini Bundler — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Core ---
# RPC_URL=https://neoxdevseed1.rolless.xyz
PRIVATE_KEY=0x_your_private_key_here
# ENTRYPOINT=0x433709009B8330FDa32311DF1C2AFA402eD8D009
PAYMASTER=0x_your_paymaster_address_here
PORT=3000

# --- Mempool ---
# MEMPOOL_MAX_SIZE=1000
# MEMPOOL_MAX_PER_SENDER=10
# MEMPOOL_TIMEOUT_MS=300000

# --- Bundle Builder ---
# BUNDLE_MAX_SIZE=10
# BUNDLE_MAX_GAS=10000000
# BUNDLE_TIMEOUT_MS=10000

# --- Gas Manager ---
# MAX_FEE_PER_GAS_CAP=50000000000
# MAX_PRIORITY_FEE_CAP=3000000000
# GAS_BUMP_PERCENT=20
# REPLACEMENT_THRESHOLD_MS=30000
# PENDING_TX_TIMEOUT_MS=120000

# --- Storage ---
# DB_PATH=./bundler.db

# --- Rate Limiting ---
# RATE_LIMIT_IP=100
# RATE_LIMIT_IP_WINDOW_MS=60000
# RATE_LIMIT_SENDER=20
# RATE_LIMIT_SENDER_WINDOW_MS=60000

# --- Logging ---
# LOG_LEVEL=INFO

# --- Security ---
# MAX_CALLDATA_LENGTH=100000
# MAX_INITCODE_LENGTH=100000
# MAX_PAYMASTER_DATA_LENGTH=100000
# MAX_GAS_LIMIT=10000000
# MAX_USEROPS_PER_BUNDLE=30
